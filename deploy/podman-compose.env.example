# Append these settings to the gitignored deploy/.env, alongside the
# credentials from the existing deployment. Paths here are relative to deploy/.
COMPOSE_FILE=docker-compose.yml:podman-compose.yml
COMPOSE_PARALLEL_LIMIT=1
# Use Podman's build API instead of requiring BuildKit/Bake.
DOCKER_BUILDKIT=0
COMPOSE_BAKE=false

# Absolute paths on the container engine host, not on the Compose client.
GUARDRAIL_DEPLOY_DIR=/absolute/path/to/checkout/deploy
GUARDRAIL_UI_DIR=/absolute/path/to/checkout/src/web/ui
